#version 460 core
// Particle update compute shader — beat-sync physics + act-specific behaviors

#define WORKGROUP_SIZE 256

layout(local_size_x = WORKGROUP_SIZE) in;

// ─── Particle Data ───────────────────────────────────────────────────────────
struct Particle {
    vec4 pos_age;      // xyz: position, w: age (s)
    vec4 vel_type;     // xyz: velocity, w: particle type (uint encoded as float)
    vec4 col_life;     // xyz: color, w: lifetime (s)
};

layout(std430, binding = 0) coherent buffer ParticleBuffer {
    Particle particles[];
} particles_rw;

layout(std430, binding = 1) readonly buffer ParticleCountBuffer {
    uint count;
    uint _pad[3];
} particle_count;

// ─── Timeline Uniforms ───────────────────────────────────────────────────────
uniform float u_time;
uniform float u_dt;
uniform float u_beat;
uniform float u_bar;
uniform float u_act_norm;
uniform float u_scene_norm;
uniform int   u_beat_cnt;
uniform int   u_bar_cnt;
uniform int   u_act_idx;     // 0=Act I  1=Act II  2=Act III  3=Act IV
uniform float u_rms;         // audio RMS amplitude [0,1]

// ─── Simulation Parameters ───────────────────────────────────────────────────
uniform float u_gravity;
uniform float u_damping;
uniform vec3  u_wind;
uniform uint  u_alive_count;

// ─── Helpers ─────────────────────────────────────────────────────────────────

float hash11(float n)     { return fract(sin(n) * 43758.5453); }
float hash21(vec2  p)     { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
vec3  hash31(float n)     {
    return vec3(hash11(n), hash11(n * 1.3 + 17.0), hash11(n * 2.7 + 53.0));
}

// 3D value noise (trilinear) — used for curl noise field
float vnoise3_c(vec3 p) {
    vec3 i = floor(p), f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float n = dot(i, vec3(1.0, 57.0, 113.0));
    return mix(mix(mix(hash11(n),       hash11(n+1.0),   f.x),
                   mix(hash11(n+57.0),  hash11(n+58.0),  f.x), f.y),
               mix(mix(hash11(n+113.0), hash11(n+114.0), f.x),
                   mix(hash11(n+170.0), hash11(n+171.0), f.x), f.y), f.z);
}

// Curl noise: divergence-free 3D flow field from finite-difference Jacobian
// of three independent value-noise fields (Bridson et al., 2007).
// No particle pile-ups (zero divergence) — creates organic swirling flows.
vec3 curl_noise(vec3 p, float t) {
    const float eps = 0.07;
    // Slowly advected sample position so the field evolves with time
    vec3 q  = p * 0.38 + vec3(t * 0.07, t * 0.05, t * 0.03);
    vec3 q2 = q + vec3(31.41, 17.28,  0.00);  // offset for noise field 2
    vec3 q3 = q + vec3( 0.00, 37.61, 53.24);  // offset for noise field 3

    // 12 noise evaluations: finite differences on three independent fields
    float n1_dy = vnoise3_c(q  + vec3(0,eps,0)) - vnoise3_c(q  - vec3(0,eps,0));
    float n1_dz = vnoise3_c(q  + vec3(0,0,eps)) - vnoise3_c(q  - vec3(0,0,eps));
    float n2_dx = vnoise3_c(q2 + vec3(eps,0,0)) - vnoise3_c(q2 - vec3(eps,0,0));
    float n2_dz = vnoise3_c(q2 + vec3(0,0,eps)) - vnoise3_c(q2 - vec3(0,0,eps));
    float n3_dx = vnoise3_c(q3 + vec3(eps,0,0)) - vnoise3_c(q3 - vec3(eps,0,0));
    float n3_dy = vnoise3_c(q3 + vec3(0,eps,0)) - vnoise3_c(q3 - vec3(0,eps,0));

    // curl(F) = (∂F3/∂y − ∂F2/∂z,  ∂F1/∂z − ∂F3/∂x,  ∂F2/∂x − ∂F1/∂y)
    return vec3(n3_dy - n2_dz, n1_dz - n3_dx, n2_dx - n1_dy) / (2.0 * eps);
}

bool is_dead(Particle p) { return p.pos_age.w > p.col_life.w; }

// Sphere surface sample (uniform distribution)
vec3 sphere_sample(float seed) {
    float theta = hash11(seed)         * 6.28318;
    float phi   = acos(1.0 - 2.0 * hash11(seed + 1.0));
    return vec3(sin(phi)*cos(theta), cos(phi), sin(phi)*sin(theta));
}

// Disc sample on XZ plane (monolith surface emission)
vec3 monolith_surface_sample(float seed) {
    float angle = hash11(seed) * 6.28318;
    float h     = (hash11(seed * 1.7) * 2.0 - 1.0) * 1.6; // monolith height
    // Monolith is ~0.4 wide, 1.6 tall, 0.2 deep — sample from its faces
    vec3 face_offsets[4] = vec3[4](
        vec3( 0.40, h, hash11(seed*3.1)*0.4 - 0.2),
        vec3(-0.40, h, hash11(seed*3.1)*0.4 - 0.2),
        vec3(hash11(seed*2.9)*0.8 - 0.4, h,  0.20),
        vec3(hash11(seed*2.9)*0.8 - 0.4, h, -0.20)
    );
    int face = int(hash11(seed * 7.7) * 4.0);
    return face_offsets[face];
}

// ─── Main Compute Kernel ─────────────────────────────────────────────────────
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_alive_count) return;

    Particle p = particles_rw.particles[idx];

    if (is_dead(p)) {
        particles_rw.particles[idx] = p;
        return;
    }

    // ─── Physics Integration ─────────────────────────────────────────────────

    // Gravity (reduced in space scenes)
    float grav_scale = mix(1.0, 0.1, smoothstep(0.4375, 0.75, u_act_norm));
    p.vel_type.xyz += vec3(0.0, u_gravity * grav_scale, 0.0) * u_dt;

    // Damping (heavier in Act II — particles settle, lighter in Act III — they float)
    float damp = mix(u_damping, 0.30, float(u_act_idx == 1) * 0.5);
    p.vel_type.xyz *= (1.0 - damp * u_dt);

    // Wind
    p.vel_type.xyz += u_wind * u_dt;

    // Beat kick: all particles get outward impulse on strong beats
    float kick_pulse = exp(-u_beat * 12.0) * step(0.001, u_beat);
    float kick_str   = mix(0.5, 2.5, smoothstep(0.1875, 0.75, u_act_norm));
    vec3 outward     = normalize(p.pos_age.xyz + vec3(0.0001));
    p.vel_type.xyz  += outward * kick_pulse * kick_str * u_dt * 60.0;

    // Act III: vortex + curl noise — particles trace organic swirling paths through
    // the fractal garden. Pure vortex alone gives mechanical spirals; curl noise
    // adds complexity so each particle carves a unique 3D curve through space.
    if (u_act_idx == 2) {
        vec3 pos = p.pos_age.xyz;

        // Tangential vortex (reduced: curl noise takes over some of the swirl)
        float dist_xz    = length(pos.xz) + 0.001;
        vec3  tangent    = vec3(-pos.z, 0.0, pos.x) / dist_xz;
        float vortex_str = smoothstep(0.4375, 0.75, u_act_norm) * 1.3;
        p.vel_type.xyz  += tangent * vortex_str * u_dt;
        p.vel_type.y    += 0.5 * u_dt;  // gentle upward drift

        // Curl noise: divergence-free flow field sculpts individual particle
        // trajectories into complex 3D curves — "living mathematics" aesthetic.
        // u_rms: loud sections push curl energy up 35% for more turbulent, alive motion.
        float curl_str  = smoothstep(0.4375, 0.75, u_act_norm) * 2.0 * (0.80 + u_rms * 0.35);
        p.vel_type.xyz += curl_noise(pos, u_time) * curl_str * u_dt;
    }

    // Act IV: big-bang entry burst + singularity pull-to-center
    if (u_act_idx == 3) {
        // Big-bang entry burst (scene_norm 0→0.055, ~3s): particles explode outward
        // mirroring the UV expansion burst in post.frag (section 0a) — spatial coherence.
        float bang_t = 1.0 - smoothstep(0.0, 0.055, u_scene_norm);
        if (bang_t > 0.001) {
            vec3 bang_dir = normalize(p.pos_age.xyz + vec3(0.0, 0.001, 0.0));
            p.vel_type.xyz += bang_dir * bang_t * 9.0 * u_dt;
        }

        // Singularity pull-to-center: ramps up over Act IV then silenced before logo
        float pull_str = smoothstep(0.75, 1.0, u_act_norm) *
                         (1.0 - smoothstep(0.80, 0.82, u_scene_norm)) * 3.0;
        vec3 to_center = -p.pos_age.xyz;
        p.vel_type.xyz += to_center * pull_str * u_dt;
    }

    // Advect position
    p.pos_age.xyz += p.vel_type.xyz * u_dt;

    // ─── Age & Fade ──────────────────────────────────────────────────────────
    p.pos_age.w += u_dt;

    // Color fade over lifetime: preserve hue, reduce intensity
    float age_fade = 1.0 - smoothstep(0.75, 1.0, p.pos_age.w / p.col_life.w);
    p.col_life.xyz = p.col_life.xyz * age_fade;

    // ─── Act-specific color shift ─────────────────────────────────────────────
    // Gently steer particle color toward act palette during flight
    float color_drift = 0.3 * u_dt;
    if (u_act_idx == 0) {
        // Act I: cold blue-white — particles are neural synapse sparks
        p.col_life.xyz = mix(p.col_life.xyz, vec3(0.6, 0.8, 1.0), color_drift);
    } else if (u_act_idx == 1) {
        // Act II: electric cyan / neon blue — city infection
        p.col_life.xyz = mix(p.col_life.xyz, vec3(0.0, 0.7, 1.0), color_drift);
    } else if (u_act_idx == 2) {
        // Act III: magenta-gold — blooming geometry
        float hue_shift = fract(u_time * 0.12 + hash11(float(idx) * 0.01));
        vec3 bloom_col  = mix(vec3(1.0, 0.3, 0.9), vec3(1.0, 0.8, 0.2), hue_shift);
        p.col_life.xyz  = mix(p.col_life.xyz, bloom_col, color_drift * 1.5);
    } else {
        // Act IV: color arc synchronized with the mathematical concept timeline —
        // mirrors the tendril color arc in 07_transcendence.frag.
        // amber-gold (Fibonacci/helix, organic birth, 0–0.44)
        //   → electric cyan (Clifford/Hopf, cosmic topology, 0.44–0.67)
        //   → violet-magenta (Julia/Riemann, complex analysis, 0.67–0.875)
        //   → pure white (singularity convergence, 0.875+)
        float sn = u_scene_norm;
        vec3 act4_col;
        if (sn < 0.44) {
            act4_col = mix(vec3(0.95, 0.68, 0.18), vec3(0.08, 0.72, 0.98),
                           smoothstep(0.22, 0.44, sn));
        } else if (sn < 0.67) {
            act4_col = mix(vec3(0.08, 0.72, 0.98), vec3(0.60, 0.10, 0.96),
                           smoothstep(0.44, 0.67, sn));
        } else {
            act4_col = mix(vec3(0.60, 0.10, 0.96), vec3(0.90, 0.95, 1.00),
                           smoothstep(0.67, 0.875, sn));
        }
        p.col_life.xyz = mix(p.col_life.xyz, act4_col, color_drift * 0.8);
    }

    particles_rw.particles[idx] = p;
}
