#version 460 core
// Particle update compute shader — beat-sync physics + act-specific behaviors

#define WORKGROUP_SIZE 256

layout(local_size_x = WORKGROUP_SIZE) in;

// ─── Particle Data ───────────────────────────────────────────────────────────
struct Particle {
    vec4 pos_age;      // xyz: position, w: age (s)
    vec4 vel_type;     // xyz: velocity, w: particle type (uint encoded as float)
    vec4 col_life;     // xyz: color, w: lifetime (s)
};

layout(std430, binding = 0) coherent buffer ParticleBuffer {
    Particle particles[];
} particles_rw;

layout(std430, binding = 1) readonly buffer ParticleCountBuffer {
    uint count;
    uint _pad[3];
} particle_count;

// ─── Timeline Uniforms ───────────────────────────────────────────────────────
uniform float u_time;
uniform float u_dt;
uniform float u_beat;
uniform float u_bar;
uniform float u_act_norm;
uniform float u_scene_norm;
uniform int   u_beat_cnt;
uniform int   u_bar_cnt;
uniform int   u_act_idx;     // 0=Act I  1=Act II  2=Act III  3=Act IV

// ─── Simulation Parameters ───────────────────────────────────────────────────
uniform float u_gravity;
uniform float u_damping;
uniform vec3  u_wind;
uniform uint  u_alive_count;

// ─── Helpers ─────────────────────────────────────────────────────────────────

float hash11(float n)     { return fract(sin(n) * 43758.5453); }
float hash21(vec2  p)     { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
vec3  hash31(float n)     {
    return vec3(hash11(n), hash11(n * 1.3 + 17.0), hash11(n * 2.7 + 53.0));
}

bool is_dead(Particle p) { return p.pos_age.w > p.col_life.w; }

// Sphere surface sample (uniform distribution)
vec3 sphere_sample(float seed) {
    float theta = hash11(seed)         * 6.28318;
    float phi   = acos(1.0 - 2.0 * hash11(seed + 1.0));
    return vec3(sin(phi)*cos(theta), cos(phi), sin(phi)*sin(theta));
}

// Disc sample on XZ plane (monolith surface emission)
vec3 monolith_surface_sample(float seed) {
    float angle = hash11(seed) * 6.28318;
    float h     = (hash11(seed * 1.7) * 2.0 - 1.0) * 1.6; // monolith height
    // Monolith is ~0.4 wide, 1.6 tall, 0.2 deep — sample from its faces
    vec3 face_offsets[4] = vec3[4](
        vec3( 0.40, h, hash11(seed*3.1)*0.4 - 0.2),
        vec3(-0.40, h, hash11(seed*3.1)*0.4 - 0.2),
        vec3(hash11(seed*2.9)*0.8 - 0.4, h,  0.20),
        vec3(hash11(seed*2.9)*0.8 - 0.4, h, -0.20)
    );
    int face = int(hash11(seed * 7.7) * 4.0);
    return face_offsets[face];
}

// ─── Main Compute Kernel ─────────────────────────────────────────────────────
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= u_alive_count) return;

    Particle p = particles_rw.particles[idx];

    if (is_dead(p)) {
        particles_rw.particles[idx] = p;
        return;
    }

    // ─── Physics Integration ─────────────────────────────────────────────────

    // Gravity (reduced in space scenes)
    float grav_scale = mix(1.0, 0.1, smoothstep(0.4375, 0.75, u_act_norm));
    p.vel_type.xyz += vec3(0.0, u_gravity * grav_scale, 0.0) * u_dt;

    // Damping (heavier in Act II — particles settle, lighter in Act III — they float)
    float damp = mix(u_damping, 0.30, float(u_act_idx == 1) * 0.5);
    p.vel_type.xyz *= (1.0 - damp * u_dt);

    // Wind
    p.vel_type.xyz += u_wind * u_dt;

    // Beat kick: all particles get outward impulse on strong beats
    float kick_pulse = exp(-u_beat * 12.0) * step(0.001, u_beat);
    float kick_str   = mix(0.5, 2.5, smoothstep(0.1875, 0.75, u_act_norm));
    vec3 outward     = normalize(p.pos_age.xyz + vec3(0.0001));
    p.vel_type.xyz  += outward * kick_pulse * kick_str * u_dt * 60.0;

    // Act III vortex: particles spiral upward as geometry blooms
    if (u_act_idx == 2) {
        vec3 pos = p.pos_age.xyz;
        float dist_xz = length(pos.xz) + 0.001;
        vec3 tangent = vec3(-pos.z, 0.0, pos.x) / dist_xz;
        float vortex_str = smoothstep(0.4375, 0.75, u_act_norm) * 2.0;
        p.vel_type.xyz += tangent * vortex_str * u_dt;
        p.vel_type.y   += 0.5 * u_dt;  // gentle upward drift
    }

    // Act IV pull-to-center: particles converge for the singularity
    if (u_act_idx == 3) {
        vec3 to_center = -p.pos_age.xyz;
        float pull_str = smoothstep(0.75, 1.0, u_act_norm) * 3.0;
        p.vel_type.xyz += to_center * pull_str * u_dt;
    }

    // Advect position
    p.pos_age.xyz += p.vel_type.xyz * u_dt;

    // ─── Age & Fade ──────────────────────────────────────────────────────────
    p.pos_age.w += u_dt;

    // Color fade over lifetime: preserve hue, reduce intensity
    float age_fade = 1.0 - smoothstep(0.75, 1.0, p.pos_age.w / p.col_life.w);
    p.col_life.xyz = p.col_life.xyz * age_fade;

    // ─── Act-specific color shift ─────────────────────────────────────────────
    // Gently steer particle color toward act palette during flight
    float color_drift = 0.3 * u_dt;
    if (u_act_idx == 0) {
        // Act I: cold blue-white — particles are neural synapse sparks
        p.col_life.xyz = mix(p.col_life.xyz, vec3(0.6, 0.8, 1.0), color_drift);
    } else if (u_act_idx == 1) {
        // Act II: electric cyan / neon blue — city infection
        p.col_life.xyz = mix(p.col_life.xyz, vec3(0.0, 0.7, 1.0), color_drift);
    } else if (u_act_idx == 2) {
        // Act III: magenta-gold — blooming geometry
        float hue_shift = fract(u_time * 0.12 + hash11(float(idx) * 0.01));
        vec3 bloom_col  = mix(vec3(1.0, 0.3, 0.9), vec3(1.0, 0.8, 0.2), hue_shift);
        p.col_life.xyz  = mix(p.col_life.xyz, bloom_col, color_drift * 1.5);
    } else {
        // Act IV: pure white / starlight — cosmic transcendence
        p.col_life.xyz = mix(p.col_life.xyz, vec3(0.9, 0.95, 1.0), color_drift * 0.5);
    }

    particles_rw.particles[idx] = p;
}
